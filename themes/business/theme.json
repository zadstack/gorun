{
  "name": "Company & services",
  "version": "1.6.0",
  "parent": "default",
  "locations": [
    "primary",
    "footer"
  ],
  "settings": [
    {
      "key": "header_style",
      "type": "select",
      "label": {
        "ar": "شكل الهيدر",
        "en": "Header layout"
      },
      "options": [
        {
          "value": "native",
          "label": {
            "ar": "هوية القالب",
            "en": "Theme identity"
          }
        },
        {
          "value": "rail",
          "label": {
            "ar": "شريط واضح",
            "en": "Clean rail"
          }
        },
        {
          "value": "framed",
          "label": {
            "ar": "إطار مستقل",
            "en": "Framed"
          }
        },
        {
          "value": "editorial",
          "label": {
            "ar": "تحريري",
            "en": "Editorial"
          }
        }
      ],
      "help": {
        "ar": "يغيّر الشكل ويحافظ على الشعار والقوائم والروابط الحالية.",
        "en": "Changes the layout while preserving your logo, menus and existing links."
      },
      "default": "native"
    },
    {
      "key": "footer_style",
      "type": "select",
      "label": {
        "ar": "شكل الفوتر",
        "en": "Footer layout"
      },
      "options": [
        {
          "value": "native",
          "label": {
            "ar": "هوية القالب",
            "en": "Theme identity"
          }
        },
        {
          "value": "signature",
          "label": {
            "ar": "توقيع الهوية",
            "en": "Brand signature"
          }
        },
        {
          "value": "columns",
          "label": {
            "ar": "أعمدة الروابط",
            "en": "Link columns"
          }
        },
        {
          "value": "minimal",
          "label": {
            "ar": "مختصر",
            "en": "Minimal"
          }
        }
      ],
      "help": {
        "ar": "يغيّر الشكل ويحافظ على الشعار والقوائم والروابط الحالية.",
        "en": "Changes the layout while preserving your logo, menus and existing links."
      },
      "default": "native"
    },
    {
      "key": "cta_label",
      "type": "text",
      "label": {
        "ar": "نص زر الهيدر",
        "en": "Header button label"
      },
      "help": {
        "ar": "مثل: اطلب استشارة. يظهر الزر عند تعبئة النص والرابط.",
        "en": "For example: Book a call. The button shows when both label and link are set."
      }
    },
    {
      "key": "cta_url",
      "type": "text",
      "label": {
        "ar": "رابط زر الهيدر",
        "en": "Header button link"
      },
      "help": {
        "ar": "مسار داخلي مثل /contact أو رابط كامل.",
        "en": "An internal path such as /contact, or a full URL."
      }
    },
    {
      "key": "footer_contact",
      "type": "textarea",
      "label": {
        "ar": "بيانات التواصل في الفوتر",
        "en": "Footer contact details"
      },
      "help": {
        "ar": "سطر لكل معلومة: البريد، الهاتف، العنوان.",
        "en": "One line each: email, phone, address."
      }
    }
  ],
  "supports": [
    "rtl",
    "identity"
  ]
