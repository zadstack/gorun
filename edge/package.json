{
  "name": "gorun-edge-readonly-poc",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "dev": "wrangler dev --local",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrations:apply": "wrangler d1 migrations apply DB --remote",
    "seed:local": "wrangler d1 execute DB --local --file fixtures/demo.sql",
    "seed:preview": "wrangler d1 execute DB --remote --file fixtures/demo.sql",
    "deploy": "npm run db:migrations:apply && npm run seed:preview && wrangler deploy",
    "package:check": "wrangler deploy --dry-run --outdir dist-upload",
    "smoke:local": "node test/local-smoke.mjs",
    "owner": "node tools/owner.mjs",
    "browser:local": "node test/owner-browser-smoke.mjs",
    "browser:remote": "node test/admin-browser.mjs"
  },
  "cloudflare": {
    "bindings": {
      "SITE_ID": {
        "description": "Leave this as `demo` so the preview fixture and `/readyz` match. The install does not enable owner administration."
      },
      "DB": {
        "description": "New D1 database for this Edge preview. Do not select a GoRun Full database."
      },
      "MEDIA": {
        "description": "New private R2 bucket for this Edge preview. Leave direct public access disabled."
      }
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@playwright/test": "1.64.1",
    "miniflare": "5.20261019.0-beta",
    "typescript": "7.0.2",
    "wrangler": "4.151.2"
  }
}
